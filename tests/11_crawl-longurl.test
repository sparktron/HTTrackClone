#!/bin/sh
set -eu
. "${srcdir:-.}/fixture-test.sh"
fixture_start
fixture_crawl "$FIXTURE_HTTP_URL/overflow/longquerywithaccents.php"
fixture_assert_file "$FIXTURE_HTTP_DIR/overflow/longquerywithaccents.html"
test -d "$FIXTURE_CRAWL_DIR/$FIXTURE_HTTP_DIR/overflow" || fixture_fail "missing long-URL output"
