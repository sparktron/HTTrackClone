#!/bin/sh
set -eu
. "${srcdir:-.}/fixture-test.sh"
fixture_start
fixture_crawl "$FIXTURE_HTTP_URL/cookies/entrance.php"
fixture_assert_file "$FIXTURE_HTTP_DIR/cookies/entrance.html"
fixture_assert_file "$FIXTURE_HTTP_DIR/cookies/second.html"
fixture_assert_file "$FIXTURE_HTTP_DIR/cookies/third.html"
