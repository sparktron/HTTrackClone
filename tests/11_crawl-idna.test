#!/bin/sh
set -eu
. "${srcdir:-.}/fixture-test.sh"
fixture_start
fixture_crawl "$FIXTURE_HTTP_URL/unicode-links/idna.html" "-*" "+127.0.0.1:*/*"
fixture_assert_file "$FIXTURE_HTTP_DIR/unicode-links/idna.html"

rm -rf "$FIXTURE_CRAWL_DIR"
fixture_crawl "$FIXTURE_HTTP_URL/unicode-links/bogus.html" "-*" "+127.0.0.1:*/*"
fixture_assert_file "$FIXTURE_HTTP_DIR/unicode-links/bogus.html"
